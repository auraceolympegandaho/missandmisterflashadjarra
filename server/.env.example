# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne JAMAIS committer le fichier ".env" reel dans un depot public.

# Port du serveur
PORT=4000

# --- Base de donnees PostgreSQL ---
# URL de connexion (Render : Dashboard > votre base Postgres > Internal/External Database URL)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Mettre a "false" pour desactiver SSL (ex: Postgres local sans SSL). Laisser vide/absent en production sur Render.
# PGSSL=false

# --- Stockage des photos (Cloudinary, offre gratuite) ---
# Creez un compte gratuit sur https://cloudinary.com puis recuperez ces 3
# valeurs dans le Dashboard (Account Details / Product Environment Credentials).
# Necessaire pour que l'upload de photos fonctionne et survive aux redeploiements.
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# URL publique du site (utilisee pour les redirections de paiement)
PUBLIC_URL=http://localhost:4000

# --- Authentification admin ---
# Identifiant et mot de passe du panel admin (le mot de passe sera hache au premier demarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Cle secrete pour signer les tokens de session admin (chaine aleatoire longue)
JWT_SECRET=remplacez_moi_par_une_longue_chaine_aleatoire

# --- FedaPay (paiement Mobile Money / carte) ---
# Creez un compte sur https://fedapay.com puis recuperez vos cles dans
# Tableau de bord > Developpeurs > Cles API
# Utilisez les cles "sandbox" pour tester, puis "live" en production.
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxx
FEDAPAY_ENV=sandbox
# Cle utilisee pour verifier la signature des webhooks FedaPay (Tableau de bord > Webhooks)
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Prix d'un vote en FCFA
PRICE_PER_VOTE=100
